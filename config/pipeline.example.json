{
  "_comment": "一键流程配置（scripts/run_pipeline.py 使用）。上传地址与密钥为占位符。",
  "inbox": "data/inbox",
  "output_dir": "output",
  "report": {
    "enabled": true,
    "output": "output/报表汇总.xlsx",
    "patterns": ["*.xlsx", "*.csv"]
  },
  "merge": {
    "enabled": true,
    "output": "output/材料合集.docx",
    "mode": "auto",
    "patterns": ["*.docx", "*.pdf", "*.txt", "*.md"]
  },
  "convert": {
    "enabled": true,
    "output_dir": "output/转换结果",
    "to": "csv",
    "patterns": ["*.xlsx"]
  },
  "classify": {
    "enabled": false,
    "config": "config/classify.example.json"
  },
  "upload": {
    "enabled": false,
    "dry_run": true,
    "config": "config/upload.example.json",
    "url": "https://your-server.example.com/api/upload",
    "token": "YOUR_API_TOKEN_HERE"
  }
}
